<div class="system-error-page">

    <div class="system-error-card">

        <div class="system-error-card__code">
            400
        </div>

        <div class="system-error-card__icon">
            <i class="fa-light fa-circle-exclamation"></i>
        </div>

        <h1>
            {{#if title}}
                {{title}}
            {{else}}
                Yêu cầu không hợp lệ
            {{/if}}
        </h1>

        <p>
            {{#if message}}
                {{message}}
            {{else}}
                Dữ liệu gửi lên không hợp lệ.
            {{/if}}
        </p>

        <a
            href="/"
            class="system-error-card__button"
        >
            <i class="fa-light fa-house"></i>
            Về trang chủ
        </a>

    </div>

</div>