<div class="system-error-page">

    <div class="system-error-card">

        <div class="system-error-card__code">
            404
        </div>

        <div class="system-error-card__icon">
            <i class="fa-light fa-map-location-dot"></i>
        </div>

        <h1>
            {{#if title}}
                {{title}}
            {{else}}
                Không tìm thấy trang
            {{/if}}
        </h1>

        <p>
            {{#if message}}
                {{message}}
            {{else}}
                Trang bạn đang tìm kiếm không tồn tại hoặc đã được di chuyển.
            {{/if}}
        </p>

        <a
            href="/"
            class="system-error-card__button"
        >
            <i class="fa-light fa-house"></i>
            Về trang chủ
        </a>

    </div>

</div>