<div class="system-error-page">

    <div class="system-error-card">

        <div class="system-error-card__code">
            500
        </div>

        <div class="system-error-card__icon">
            <i class="fa-light fa-server"></i>
        </div>

        <h1>
            {{#if title}}
            {{title}}
            {{else}}
            Lỗi máy chủ
            {{/if}}
        </h1>

        <p>
            {{#if message}}
            {{message}}
            {{else}}
            Hệ thống đang gặp sự cố. Vui lòng thử lại sau.
            {{/if}}
        </p>

        <a href="/" class="system-error-card__button">
            <i class="fa-light fa-house"></i>
            Về trang chủ
        </a>

    </div>

</div>