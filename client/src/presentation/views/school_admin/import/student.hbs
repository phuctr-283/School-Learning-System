<div class="section-title">

    <i class="fa-light fa-school-flag"></i>

    <h2>
        Import
    </h2>

</div>


<div class="import-card import-card--student">

    <div class="import-card__body">


        <!-- HEADER -->
        <div class="import-header">

            <div class="import-header__icon">
                <i class="fa-light fa-user-graduate"></i>
            </div>


            <div class="import-header__content">

                <h5>
                    Nhập dữ liệu sinh viên
                </h5>

                <span>
                    Thêm danh sách sinh viên từ tập tin Excel
                </span>

            </div>

        </div>


        <!-- FORM -->
        <form action="/school-admin/imports/students/import" method="POST" enctype="multipart/form-data" class="import-form"
            data-import-form>

            <div class="import-section">

                <div class="import-section__title">

                    <i class="fa-light fa-file-import"></i>

                    <span>
                        Tập tin sinh viên
                    </span>

                </div>


                <!-- UPLOAD -->
                <div class="import-upload">

                    <div class="import-upload__icon">
                        <i class="fa-light fa-file-excel"></i>
                    </div>


                    <div class="import-upload__content">

                        <h6>
                            Chọn tập tin sinh viên
                        </h6>

                        <p>

                            Hỗ trợ

                            <strong>
                                .XLSX
                            </strong>

                        </p>

                    </div>


                    <div class="import-upload__input">

                        <label for="studentFile" class="import-upload__button">

                            <i class="fa-light fa-folder-open"></i>

                            <span>
                                Chọn tập tin
                            </span>

                        </label>


                        <input type="file" id="studentFile" name="file" accept=".xlsx" required data-import-file>


                        <span class="import-upload__filename" data-import-file-name>

                            Chưa chọn tập tin

                        </span>

                    </div>


                    <small class="import-upload__hint">

                        Dung lượng tối đa:

                        <strong>
                            128 MiB
                        </strong>

                    </small>

                </div>


                <!-- FILE PREVIEW -->
                <div class="import-file-preview" data-import-preview hidden>

                    <div class="import-file-preview__icon">

                        <i class="fa-light fa-file-excel"></i>

                    </div>


                    <div class="import-file-preview__content">

                        <strong class="import-file-preview__name">
                            -
                        </strong>


                        <span class="import-file-preview__size">
                            -
                        </span>

                    </div>


                    <button type="button" class="import-file-preview__remove" title="Xóa tập tin" data-import-remove>

                        <i class="fa-light fa-xmark"></i>

                    </button>

                </div>


                <!-- NOTE -->
                <div class="import-note">

                    <i class="fa-light fa-circle-info"></i>

                    <div>

                        <strong>
                            Định dạng dữ liệu
                        </strong>

                        <p>

                            File Excel phải chứa đúng các cột:

                            <code>Mã sinh viên</code>,
                            <code>Họ tên</code>,
                            <code>Lớp</code>,
                            <code>Giới tính</code>,
                            <code>Khóa</code>,
                            <code>Khoa</code>,
                            <code>Email</code>,
                            <code>Trạng thái</code>.

                        </p>

                    </div>

                </div>

            </div>


            <!-- OPTIONS -->
            <div class="import-options">

                <div class="import-field">

                    <label for="studentCharset">

                        <i class="fa-light fa-language"></i>

                        Bảng mã của tập tin

                    </label>


                    <select id="studentCharset" name="charset">

                        <option value="utf-8" selected>
                            UTF-8
                        </option>

                        <option value="utf-16">
                            UTF-16
                        </option>

                    </select>


                    <small>
                        Khuyến nghị UTF-8 để hỗ trợ tiếng Việt.
                    </small>

                </div>

            </div>


            <!-- ACTION -->
            <div class="import-actions">

                <button type="submit" class="import-btn" data-import-button>

                    <span data-import-normal>

                        <i class="fa-light fa-file-arrow-up"></i>

                        <span>
                            Nhập sinh viên
                        </span>

                    </span>


                    <span data-import-loading hidden>

                        <i class="fa-light fa-spinner fa-spin"></i>

                        <span>
                            Đang nhập...
                        </span>

                    </span>

                </button>

            </div>

        </form>


        <!-- ERROR -->
        {{#if error}}

        <div class="import-result" data-import-result>

            <div class="import-result__status is-error">

                <div class="import-result__status-icon">

                    <i class="fa-light fa-circle-exclamation"></i>

                </div>


                <div class="import-result__status-content">

                    <strong>
                        Import sinh viên thất bại
                    </strong>

                    <span>
                        {{error}}
                    </span>

                </div>


                <button type="button" class="import-result__close" title="Đóng thông báo" data-import-close>

                    <i class="fa-light fa-xmark"></i>

                </button>

            </div>


            <div class="import-result__footer">

                <span>

                    <i class="fa-light fa-circle-info"></i>

                    Kiểm tra lại dữ liệu trong file Excel.

                </span>


                <button type="button" class="import-result__reset" data-import-again>

                    <i class="fa-light fa-rotate-right"></i>

                    Nhập lại

                </button>

            </div>

        </div>

        {{/if}}


        <!-- SUCCESS -->
        {{#if importSuccess}}

        <div class="import-result" data-import-result>

            <div class="import-result__status is-success">

                <div class="import-result__status-icon">

                    <i class="fa-light fa-circle-check"></i>

                </div>


                <div class="import-result__status-content">

                    <strong>
                        Import sinh viên thành công
                    </strong>

                    <span>
                        {{importMessage}}
                    </span>

                </div>


                <button type="button" class="import-result__close" title="Đóng thông báo" data-import-close>

                    <i class="fa-light fa-xmark"></i>

                </button>

            </div>


            <!-- STATS -->
            <div class="import-result__stats">

                <div class="import-stat import-stat--success">

                    <div class="import-stat__icon">
                        <i class="fa-light fa-user-graduate"></i>
                    </div>

                    <div class="import-stat__content">

                        <span>
                            Đã nhập
                        </span>

                        <strong>
                            {{importCount}}
                        </strong>

                    </div>

                </div>


                <div class="import-stat import-stat--update">

                    <div class="import-stat__icon">
                        <i class="fa-light fa-file-check"></i>
                    </div>

                    <div class="import-stat__content">

                        <span>
                            Trạng thái
                        </span>

                        <strong>
                            Thành công
                        </strong>

                    </div>

                </div>

            </div>


            <!-- FOOTER -->
            <div class="import-result__footer">

                <span>

                    <i class="fa-light fa-circle-check"></i>

                    Dữ liệu sinh viên đã được lưu vào hệ thống.

                </span>


                <button type="button" class="import-result__reset" data-import-again>

                    <i class="fa-light fa-plus"></i>

                    Nhập file khác

                </button>

            </div>

        </div>

        {{/if}}

    </div>

</div>