<div class="section-title">
    <i class="fa-light fa-rectangle-list"></i>
    <h2>Kế hoạch lớp học phần</h2>
</div>

<div class="data-card class-section-plan-page">
    <div class="data-card__body">

        <!-- =========================================
             TOOLBAR
        ========================================== -->
        <div class="data-toolbar">

            <div class="data-toolbar__title">

                <div class="class-section-plan-page-title">

                    <div class="class-section-plan-page-title__icon">
                        <i class="fa-light fa-rectangle-list"></i>
                    </div>

                    <div>
                        <h5>Danh sách kế hoạch lớp học phần</h5>

                        <span>
                            Quản lý kế hoạch giảng dạy theo từng lớp học phần
                        </span>
                    </div>

                </div>

            </div>

            <div class="data-toolbar__actions">

                <div class="data-search">
                    <i class="fa-light fa-magnifying-glass"></i>

                    <input
                        type="text"
                        id="searchClassSectionLessonPlan"
                        placeholder="Tìm mã lớp, môn học hoặc học kỳ..."
                    />

                </div>

            </div>

        </div>


        <!-- =========================================
             TABLE
        ========================================== -->
        <div class="data-table-wrap">

            <table class="data-table data-table--class-section-plan">

                <thead>

                    <tr>

                        <th class="text-center">
                            Lớp học phần
                        </th>

                        <th>
                            Môn học
                        </th>

                        <th class="text-center">
                            Nhóm
                        </th>

                        <th>
                            Học kỳ
                        </th>

                        <th>
                            Năm học
                        </th>

                        <th class="text-center">
                            Số tiết
                        </th>

                        <th class="text-center">
                            Trạng thái
                        </th>

                        <th class="text-center">
                            Hoạt động
                        </th>

                    </tr>

                </thead>


                <tbody>

                    {{#each classSectionLessonPlans}}

                    <tr>

                        <!-- =================================
                             CLASS SECTION
                        ================================== -->
                        <td>

                            <div class="class-section-plan-class">

                                <div class="class-section-plan-class__icon">
                                    <i class="fa-light fa-screen-users"></i>
                                </div>

                                <div class="class-section-plan-class__content">

                                    <span class="class-section-plan-class__id">
                                        {{this.classSectionId}}
                                    </span>

                                    <small>
                                        {{this.classSectionLessonPlanId}}
                                    </small>

                                </div>

                            </div>

                        </td>


                        <!-- =================================
                             SUBJECT
                        ================================== -->
                        <td>

                            <div class="class-section-plan-subject">

                                <div class="class-section-plan-subject__icon">
                                    <i class="fa-light fa-book-open"></i>
                                </div>

                                <div class="class-section-plan-subject__content">

                                    <span class="class-section-plan-subject__name">
                                        {{this.subjectName}}
                                    </span>

                                    {{#if this.subjectId}}

                                    <small>
                                        {{this.subjectId}}
                                    </small>

                                    {{/if}}

                                </div>

                            </div>

                        </td>


                        <!-- =================================
                             GROUP
                        ================================== -->
                        <td class="text-center">

                            <span class="class-section-plan-group">
                                Nhóm {{this.groupNumber}}
                            </span>

                        </td>


                        <!-- =================================
                             SEMESTER
                        ================================== -->
                        <td>

                            <div class="class-section-plan-semester">

                                <div class="class-section-plan-semester__icon">
                                    <i class="fa-light fa-calendar-days"></i>
                                </div>

                                <div class="class-section-plan-semester__content">

                                    <span>
                                        {{this.semesterName}}
                                    </span>

                                    {{#if this.semesterNumber}}

                                    <small>
                                        Học kỳ {{this.semesterNumber}}
                                    </small>

                                    {{/if}}

                                </div>

                            </div>

                        </td>


                        <!-- =================================
                             ACADEMIC YEAR
                        ================================== -->
                        <td>

                            <div class="class-section-plan-academic-year">

                                <i class="fa-light fa-calendar-range"></i>

                                <span>
                                    {{this.academicYearName}}
                                </span>

                            </div>

                        </td>


                        <!-- =================================
                             TOTAL LESSONS
                        ================================== -->
                        <td class="text-center">

                            <div class="class-section-plan-lessons">

                                <strong>
                                    {{this.effectiveTotalLessons}}
                                </strong>

                                <span>
                                    tiết
                                </span>

                                {{#if this.isCustom}}

                                <small>
                                    <i class="fa-light fa-sliders"></i>
                                    Tùy chỉnh
                                </small>

                                {{/if}}

                            </div>

                        </td>


                        <!-- =================================
                             STATUS
                        ================================== -->
                        <td class="text-center">

                            {{#if this.effectiveTotalLessons}}

                            <span class="data-status data-status--active">

                                <span class="data-status__dot"></span>

                                Đã thiết lập

                            </span>

                            {{else}}

                            <span class="data-status data-status--inactive">

                                <span class="data-status__dot"></span>

                                Chưa thiết lập

                            </span>

                            {{/if}}

                        </td>


                        <!-- =================================
                             ACTION
                        ================================== -->
                        <td class="text-center">

                            <div class="class-section-plan-actions">

                                <a
                                    href="/school-admin/university/class-section-lesson-plans/{{this.classSectionLessonPlanId}}"
                                    class="lesson-action lesson-action--view"
                                    title="Xem kế hoạch"
                                >
                                    <i class="fa-light fa-eye"></i>
                                </a>

                                <a
                                    href="/school-admin/university/class-section-lesson-plans/{{this.classSectionLessonPlanId}}/edit"
                                    class="lesson-action lesson-action--edit"
                                    title="Chỉnh sửa kế hoạch"
                                >
                                    <i class="fa-light fa-pen"></i>
                                </a>

                            </div>

                        </td>

                    </tr>


                    {{else}}

                    <!-- =================================
                         EMPTY STATE
                    ================================== -->
                    <tr>

                        <td colspan="8" class="text-center">

                            <div class="class-section-plan-empty">

                                <div class="class-section-plan-empty__icon">

                                    <i class="fa-light fa-rectangle-list"></i>

                                </div>

                                <div class="class-section-plan-empty__content">

                                    <strong>
                                        Chưa có kế hoạch lớp học phần
                                    </strong>

                                    <span>
                                        Hiện chưa có dữ liệu kế hoạch giảng dạy
                                        cho các lớp học phần.
                                    </span>

                                </div>

                            </div>

                        </td>

                    </tr>

                    {{/each}}

                </tbody>

            </table>

        </div>

    </div>
</div>