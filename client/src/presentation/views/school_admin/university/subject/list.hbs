<div class="section-title subject-section-title">
    <i class="fa-light fa-grid"></i>
    <h2>Môn học</h2>
</div>

<div class="data-card subject-data-card">
    <div class="data-card__body">

        <div class="data-toolbar">

            <div class="data-toolbar__title">
                <div class="subject-toolbar-title">

                    <div class="subject-toolbar-title__icon">
                        <i class="fa-light fa-book-open"></i>
                    </div>

                    <div class="subject-toolbar-title__content">
                        <h5>Tất cả môn học</h5>
                        <span>Quản lý danh sách môn học</span>
                    </div>

                </div>
            </div>

            <div class="data-toolbar__actions">

                <div class="data-search">
                    <i class="fa-light fa-magnifying-glass"></i>
                    <input type="text" id="searchSubject" placeholder="Tìm theo mã hoặc tên môn...">
                </div>

                <a href="/school-admin/university/subjects/create"
                    class="data-btn data-btn--primary subject-create-btn">
                    <i class="fa-light fa-plus"></i>
                    <span>Thêm môn học</span>
                </a>

            </div>

        </div>


        <div class="data-table-wrap">

            <table class="data-table data-table--subject">

                <thead>

                    <tr>

                        <th class="text-center">
                            Mã môn học
                        </th>

                        <th>
                            Tên môn học
                        </th>

                        <th>
                            Khoa
                        </th>

                        <th class="text-center">
                            Tín chỉ
                        </th>

                        <th class="text-center">
                            Loại môn
                        </th>

                        <th class="text-center">
                            % Quá trình
                        </th>

                        <th class="text-center">
                            % Giữa kỳ
                        </th>

                        <th class="text-center">
                            % Cuối kỳ
                        </th>

                        <th class="text-center">
                            Trạng thái
                        </th>

                        <th class="text-center">
                            Hoạt động
                        </th>

                    </tr>

                </thead>


                <tbody>

                    {{#each subjects}}

                    <tr>

                        <!-- MÃ MÔN -->
                        <td class="text-center">

                            <span class="subject-code">
                                {{subjectId}}
                            </span>

                        </td>


                        <!-- TÊN MÔN -->
                        <td>

                            <div class="subject-name">

                                <div class="subject-name__icon">
                                    <i class="fa-light fa-book-open"></i>
                                </div>

                                <div class="subject-name__content">

                                    <strong>
                                        {{name}}
                                    </strong>

                                    {{#if universityName}}
                                    <small>
                                        {{universityName}}
                                    </small>
                                    {{/if}}

                                </div>

                            </div>

                        </td>


                        <!-- KHOA -->
                        <td>

                            <div class="subject-department">

                                <span class="subject-department__icon">
                                    <i class="fa-light fa-building"></i>
                                </span>

                                <div class="subject-department__content">

                                    <strong>
                                        {{departmentName}}
                                    </strong>

                                    {{#if departmentId}}
                                    <small>
                                        {{departmentId}}
                                    </small>
                                    {{/if}}

                                </div>

                            </div>

                        </td>


                        <!-- TÍN CHỈ -->
                        <td class="text-center">

                            <span class="subject-credit">
                                {{credits}}
                            </span>

                        </td>


                        <!-- SUBJECT TYPE -->
                        <td class="text-center">

                            <div class="subject-types">

                                {{#if subjectTypes}}

                                {{#if (eq subjectTypes "Theory")}}
                                <span class="subject-type subject-type--theory">
                                    <i class="fa-light fa-book"></i>
                                    <span>Lý thuyết</span>
                                </span>
                                {{/if}}

                                {{#if (eq subjectTypes "Practice")}}
                                <span class="subject-type subject-type--practice">
                                    <i class="fa-light fa-flask"></i>
                                    <span>Thực hành</span>
                                </span>
                                {{/if}}

                                {{else}}

                                <span class="subject-type subject-type--empty">
                                    Chưa xác định
                                </span>

                                {{/if}}

                            </div>

                        </td>


                        <!-- QUÁ TRÌNH -->
                        <td class="text-center">

                            <span class="subject-percentage">
                                {{processPercent}}%
                            </span>

                        </td>


                        <!-- GIỮA KỲ -->
                        <td class="text-center">

                            <span class="subject-percentage">
                                {{midtermPercent}}%
                            </span>

                        </td>


                        <!-- CUỐI KỲ -->
                        <td class="text-center">

                            <span class="subject-percentage">
                                {{finalPercent}}%
                            </span>

                        </td>


                        <!-- TRẠNG THÁI -->
                        <td class="text-center">

                            {{#if (eq status "active")}}

                            <span class="data-status data-status--active">

                                <span class="data-status__dot"></span>

                                Đang hoạt động

                            </span>

                            {{else}}

                            <span class="data-status data-status--inactive">

                                <span class="data-status__dot"></span>

                                Không hoạt động

                            </span>

                            {{/if}}

                        </td>


                        <!-- HOẠT ĐỘNG -->
                        <td class="text-center">

                            <a href="/admin/university/subject/{{subjectId}}/edit" class="data-action subject-action"
                                title="Chỉnh sửa môn học">

                                <i class="fa-light fa-pen-to-square"></i>

                                <span>Sửa</span>

                            </a>

                        </td>

                    </tr>


                    {{else}}

                    <tr>

                        <td colspan="10" class="text-center">

                            <div class="data-empty subject-empty">

                                <div class="data-empty__icon">
                                    <i class="fa-light fa-book-open"></i>
                                </div>

                                <div class="data-empty__content">

                                    <strong>
                                        Chưa có môn học
                                    </strong>

                                    <span>
                                        Chưa có dữ liệu môn học trong hệ thống.
                                    </span>

                                </div>

                            </div>

                        </td>

                    </tr>

                    {{/each}}

                </tbody>

            </table>

        </div>

    </div>
</div>