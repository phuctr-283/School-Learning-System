<h2 class="subject-name">
  {{subjectName}}
</h2>

<div class="assignment-list">

  {{#if assignments.length}}

    {{#each assignments}}

      {{#if (eq classSectionStatus "active")}}

        <a
          href="/student/exercise/{{assignmentApplicationId}}"
          class="assignment-card"
        >
          <div class="assignment-card-content">
            <div class="assignment-card-name">
              {{title}}
            </div>
          </div>

          <div class="assignment-card-arrow">
            <i class="fa-light fa-chevron-right"></i>
          </div>
        </a>

      {{else}}

        <div class="assignment-card is-locked">
          <div class="assignment-card-content">
            <div class="assignment-card-name">
              {{title}}
            </div>
          </div>

          <div class="assignment-card-lock">
            <i class="fa-light fa-lock"></i>
          </div>
        </div>

      {{/if}}

    {{/each}}

  {{else}}

    <div class="assignment-empty">
      <i class="fa-light fa-clipboard-list"></i>

      <span>
        Chưa có bài tập nào.
      </span>
    </div>

  {{/if}}

</div>