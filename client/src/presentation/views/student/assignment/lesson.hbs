<h2 class="subject-name">
    {{subjectName}}
</h2>

<div class="lesson-list">

    {{#each lessons}}

    {{#if (eq status "open")}}

    <a href="/student/assignment/class-sections/{{../classSectionId}}/lessons/{{lessonId}}/assignment" class="lesson-card">

        <div class="lesson-card-content">

            <div class="lesson-card-name">
                Buổi {{lessonNumber}}
            </div>

            <div class="lesson-card-progress">

                <i class="fa-light fa-circle-check"></i>

                <span>
                    0/3
                </span>

            </div>

        </div>

        <div class="lesson-card-arrow">

            <i class="fa-light fa-chevron-right"></i>

        </div>

    </a>

    {{else if (eq status "locked")}}

    <div class="lesson-card is-locked">

        <div class="lesson-card-content">

            <div class="lesson-card-name">
                Buổi {{lessonNumber}}
            </div>

            <div class="lesson-card-progress">

                <i class="fa-light fa-circle-check"></i>

                <span>
                    0/3
                </span>

            </div>

        </div>

        <div class="lesson-card-lock">

            <i class="fa-light fa-lock"></i>

        </div>

    </div>

    {{else if (eq status "closed")}}

    <div class="lesson-card is-closed">

        <div class="lesson-card-content">

            <div class="lesson-card-name">
                Buổi {{lessonNumber}}
            </div>

            <div class="lesson-card-progress">

                <i class="fa-light fa-circle-check"></i>

                <span>
                    0/3
                </span>

            </div>

        </div>

        <div class="lesson-card-closed">

            <i class="fa-light fa-circle-xmark"></i>

            <span>
                Đã đóng
            </span>

        </div>

    </div>

    {{/if}}

    {{else}}

    <div class="lesson-empty">

        <i class="fa-light fa-book-open"></i>

        <span>
            Chưa có buổi học nào.
        </span>

    </div>

    {{/each}}

</div>