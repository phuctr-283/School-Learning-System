<div class="section-title">
    <i class="fa-light fa-memo"></i>

    <h2>
        Bài tập
    </h2>
</div>

<div class="subject-list">

    {{#each subjects}}

    <a
        href="/student/assignment/{{academicYearId}}/{{semesterId}}/{{subjectId}}/{{groupNumber}}"
        class="subject-card"
    >

        <div class="subject-card-icon">
            <i class="fa-light fa-book"></i>
        </div>

        <div class="subject-card-content">

            <div class="subject-card-name">
                {{subjectName}}
            </div>

            <div class="subject-card-teacher">
                <i class="fa-light fa-user"></i>

                <span>
                    {{teacherName}}
                </span>
            </div>

        </div>

        <div class="subject-card-arrow">
            <i class="fa-light fa-chevron-right"></i>
        </div>

    </a>

    {{else}}

    <div class="subject-empty">
        <i class="fa-light fa-book-open"></i>

        <span>
            Hiện chưa có môn học nào đang hoạt động
        </span>
    </div>

    {{/each}}

</div>