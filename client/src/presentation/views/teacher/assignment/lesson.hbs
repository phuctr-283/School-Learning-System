<div class="title mx-3 class-section-page-title">
    <div>
        <h2 class="class-section-page-title__heading">
            Nội dung học tập
        </h2>

        <h4 class="class-section-page-title__subheading">
            Danh sách buổi học
        </h4>
    </div>
</div>


<div class="data-card mx-2 class-section-table-card">

    <div class="data-card-body">
        <div class="lesson-opening-list" data-class-section-id="{{classSectionId}}"
            data-class-section-lesson-plan-id="{{classSectionLessonPlanId}}">
            <div class="data-table-wrap">

                <table class="data-table class-section-table">

                    <thead>
                        <tr>
                            <th>Buổi học</th>
                            <th>Trạng thái</th>
                            <th>Hoạt động</th>
                            <th>Nội dung</th>
                        </tr>
                    </thead>

                    <tbody>

                        {{#each lessonOpenings}}

                        <tr class="lesson-opening-row">

                            <td>
                                <div class="lesson-opening-name">

                                    <span class="lesson-opening-number">
                                        {{lessonNumber}}
                                    </span>

                                    <div class="lesson-opening-info">

                                        <span class="lesson-opening-title">
                                            {{#if lessonName}}
                                            {{lessonName}}
                                            {{else}}
                                            Buổi {{lessonNumber}}
                                            {{/if}}
                                        </span>

                                        {{#if lessonId}}
                                        <span class="lesson-opening-id">
                                            Mã buổi: {{lessonId}}
                                        </span>
                                        {{/if}}

                                    </div>

                                </div>
                            </td>


                            <td>

                                <span class="lesson-opening-status
                                    {{#if (eq status "open")}} lesson-opening-status--open {{else if (eq
                                    status "closed" )}} lesson-opening-status--closed {{else}}
                                    lesson-opening-status--locked {{/if}}">

                                    {{#if (eq status "open")}}
                                    Đang mở
                                    {{else if (eq status "closed")}}
                                    Đã đóng
                                    {{else}}
                                    Đang khóa
                                    {{/if}}

                                </span>

                            </td>

                            <td>
                                <button type="button" class="lesson-opening-status-button
                                    {{#if (eq status "open")}}is-active{{/if}}" data-lesson-id="{{lessonId}}"
                                    data-status="{{status}}" title="{{#if (eq status "open")}} Đóng buổi học {{else if
                                    (eq status "closed" )}} Mở buổi học {{else}} Buổi học đang khóa {{/if}}">
                                    <span class="lesson-opening-status-icon">
                                        <i class="fa-light fa-power-off"></i>
                                    </span>

                                    <span class="lesson-opening-status-text">
                                        {{#if (eq status "open")}}
                                        Đang bật
                                        {{else}}
                                        Đang tắt
                                        {{/if}}
                                    </span>
                                </button>

                            </td>

                            <td>

                                {{#if (eq status "open")}}

                                <button type="button" class="lesson-opening-content-toggle" aria-expanded="false"
                                    aria-controls="lesson-content-{{lessonId}}" data-lesson-id="{{lessonId}}">

                                    <span class="lesson-opening-content-icon">
                                        <i class="fa-light fa-chevron-down"></i>
                                    </span>

                                    <span>
                                        Xem bài tập
                                    </span>

                                </button>

                                {{else}}

                                <span class="lesson-opening-content-disabled">
                                    Chưa mở nội dung
                                </span>

                                {{/if}}

                            </td>

                        </tr>


                        {{#if (eq status "open")}}

                        <tr id="lesson-content-{{lessonId}}" class="lesson-content-panel" hidden>
                            <td colspan="4">

                                <div class="lesson-content-panel__inner">

                                    <div class="lesson-assignments" data-class-section-id="{{../classSectionId}}"
                                        data-lesson-id="{{lessonId}}">

                                        <div class="assignment-loading" hidden>
                                            <i class="fa-light fa-spinner fa-spin"></i>
                                            Đang tải bài tập...
                                        </div>

                                        <div class="assignment-list"></div>

                                        <div class="assignment-empty" hidden>
                                            <i class="fa-light fa-inbox"></i>

                                            <span>
                                                Buổi học này chưa có bài tập.
                                            </span>
                                        </div>

                                        <div class="assignment-error" hidden></div>

                                    </div>

                                </div>

                            </td>
                        </tr>

                        {{/if}}

                        {{else}}

                        <tr>

                            <td colspan="4">

                                <div class="lesson-opening-empty">
                                    <i class="fa-light fa-calendar-xmark"></i>
                                    Chưa có buổi học.
                                </div>

                            </td>

                        </tr>

                        {{/each}}

                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>