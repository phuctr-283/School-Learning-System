<!-- MODAL XÁC NHẬN -->

<div class="modal fade" id="changeLessonStatusModal" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form id="changeLessonStatusForm">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Xác nhận thay đổi
                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

                </div>

                <div class="modal-body">

                    <p id="changeLessonStatusMessage">
                        Bạn có chắc chắn muốn thay đổi trạng thái buổi học?
                    </p>

                    <input type="hidden" id="lessonId" />

                    <input type="hidden" id="newLessonStatus" />

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Hủy
                    </button>

                    <button type="submit" class="btn btn-primary">
