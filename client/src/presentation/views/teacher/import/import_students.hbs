<div class="section-title">
    <i class="fa-light fa-school-flag"></i>
    <h2>Import</h2>
</div>

<div class="import-card import-card--student">

    <div class="import-card__body">

        <!-- HEADER -->
        <div class="import-header">

            <div class="import-header__icon">
                <i class="fa-light fa-user-graduate"></i>
            </div>

            <div class="import-header__content">

                <h5>
                    Nhập dữ liệu sinh viên
                </h5>

                <span>
                    Thêm danh sách sinh viên vào lớp học phần từ tập tin Excel
                </span>

            </div>

        </div>


        <!-- FORM -->
        <form action="/teacher/import/student" method="POST" enctype="multipart/form-data" class="import-form">

            <!-- FILE SECTION -->
            <div class="import-section">

                <div class="import-section__title">

                    <i class="fa-light fa-file-import"></i>

                    <span>
                        Tập tin sinh viên
                    </span>

                </div>


                <!-- UPLOAD -->
                <div class="import-upload">

                    <div class="import-upload__icon">
                        <i class="fa-light fa-file-excel"></i>
                    </div>


                    <div class="import-upload__content">

                        <h6>
                            Chọn tập tin sinh viên
                        </h6>

                        <p>
                            Hỗ trợ
                            <strong>.XLSX</strong>
                        </p>

                    </div>


                    <div class="import-upload__input">

                        <label for="studentFile" class="import-upload__button">

                            <i class="fa-light fa-folder-open"></i>

                            <span>
                                Chọn tập tin
                            </span>

                        </label>


                        <input type="file" id="studentFile" name="file" accept=".xlsx" required
                            class="import-file-input" />


                        <span class="import-upload__filename">

                            Chưa chọn tập tin

                        </span>

                    </div>


                    <small class="import-upload__hint">

                        Dung lượng tối đa:

                        <strong>
                            128 MiB
                        </strong>

                    </small>

                </div>


                <!-- FILE PREVIEW -->
                <div class="import-file-preview" hidden>

                    <div class="import-file-preview__icon">

                        <i class="fa-light fa-file-excel"></i>

                    </div>


                    <div class="import-file-preview__content">

                        <strong class="import-file-preview__name">
                            -
                        </strong>

                        <span class="import-file-preview__size">
                            -
                        </span>

                    </div>


                    <button type="button" class="import-file-preview__remove" title="Xóa tập tin">

                        <i class="fa-light fa-xmark"></i>

                    </button>

                </div>


                <!-- NOTE -->
                <div class="import-note">

                    <i class="fa-light fa-circle-info"></i>


                    <div>

                        <strong>
                            Định dạng dữ liệu Excel
                        </strong>


                        <p>

                            File Excel phải có thông tin môn học và nhóm
                            ở đầu file, sau đó là danh sách sinh viên.

                        </p>


                        <div class="import-excel-format">

                            <div class="import-excel-format__row">

                                <span>
                                    Môn:
                                </span>

                                <code>
                                    Tên môn học
                                </code>

                            </div>


                            <div class="import-excel-format__row">

                                <span>
                                    Nhóm:
                                </span>

                                <code>
                                    Số nhóm
                                </code>

                            </div>


                            <div class="import-excel-format__row">

                                <span>
                                    Học kỳ:
                                </span>

                                <code>
                                    Số học kỳ
                                </code>

                            </div>


                            <div class="import-excel-format__row">

                                <span>
                                    Năm học:
                                </span>

                                <code>
                                    Tên năm học
                                </code>

                            </div>

                        </div>


                        <p>

                            Danh sách sinh viên phải có các cột:

                            <code>MSSV</code>,
                            <code>Họ và tên</code>,
                            <code>Lớp</code>.

                        </p>

                    </div>

                </div>

            </div>


            <!-- OPTIONS -->
            <div class="import-options">

                <div class="import-field">

                    <label for="studentCharset">

                        <i class="fa-light fa-language"></i>

                        Bảng mã của tập tin

                    </label>


                    <select id="studentCharset" name="charset">

                        <option value="utf-8" selected>
                            UTF-8
                        </option>

                        <option value="utf-16">
                            UTF-16
                        </option>

                    </select>


                    <small>
                        Khuyến nghị UTF-8 để hỗ trợ tiếng Việt.
                    </small>

                </div>

            </div>


            <!-- ACTION -->
            <div class="import-actions">

                <button type="submit" class="import-btn">

                    <!-- NORMAL -->
                    <span class="import-btn__normal">

                        <i class="fa-light fa-file-arrow-up"></i>

                        <span>
                            Nhập sinh viên
                        </span>

                    </span>


                    <!-- LOADING -->
                    <span class="import-btn__loading" hidden>

                        <i class="fa-light fa-spinner fa-spin"></i>

                        <span>
                            Đang nhập...
                        </span>

                    </span>

                </button>

            </div>

        </form>


        <!-- ERROR -->
        {{#if error}}

        <div class="import-result">

            <div class="import-result__status is-error">

                <div class="import-result__status-icon">

                    <i class="fa-light fa-circle-exclamation"></i>

                </div>


                <div class="import-result__status-content">

                    <strong>
                        Import sinh viên thất bại
                    </strong>

                    <span>
                        {{error}}
                    </span>

                </div>


                <button type="button" class="import-result__close" title="Đóng thông báo">

                    <i class="fa-light fa-xmark"></i>

                </button>

            </div>


            <div class="import-result__footer">

                <span>

                    <i class="fa-light fa-circle-info"></i>

                    Kiểm tra lại cấu trúc và dữ liệu
                    trong file Excel.

                </span>


                <button type="button" class="import-result__reset">

                    <i class="fa-light fa-rotate-right"></i>

                    Nhập lại

                </button>

            </div>

        </div>

        {{/if}}


        <!-- SUCCESS -->
        {{#if importSuccess}}

        <div class="import-result">

            <!-- STATUS -->
            <div class="import-result__status is-success">

                <div class="import-result__status-icon">

                    <i class="fa-light fa-circle-check"></i>

                </div>


                <div class="import-result__status-content">

                    <strong>
                        Import sinh viên hoàn tất
                    </strong>

                    <span>
                        {{importMessage}}
                    </span>

                </div>


                <button type="button" class="import-result__close" title="Đóng thông báo">

                    <i class="fa-light fa-xmark"></i>

                </button>

            </div>


            <!-- CONTEXT -->
            <div class="import-result__context">

                <div class="import-result__context-item">

                    <i class="fa-light fa-book"></i>

                    <span>
                        Môn học
                    </span>

                    <strong>
                        {{subjectName}}
                    </strong>

                </div>


                <div class="import-result__context-item">

                    <i class="fa-light fa-users"></i>

                    <span>
                        Nhóm
                    </span>

                    <strong>
                        {{groupNumber}}
                    </strong>

                </div>

            </div>


            <!-- STATS -->
            <div class="import-result__stats">

                <!-- IMPORTED -->
                <div class="import-stat import-stat--success">

                    <div class="import-stat__icon">

                        <i class="fa-light fa-user-plus"></i>

                    </div>


                    <div class="import-stat__content">

                        <span>
                            Đã thêm mới
                        </span>

                        <strong>
                            {{importCount}}
                        </strong>

                    </div>

                </div>


                <!-- SKIPPED -->
                <div class="import-stat import-stat--update">

                    <div class="import-stat__icon">

                        <i class="fa-light fa-forward"></i>

                    </div>


                    <div class="import-stat__content">

                        <span>
                            Đã bỏ qua trùng
                        </span>

                        <strong>
                            {{skippedCount}}
                        </strong>

                    </div>

                </div>


                <!-- NOT FOUND -->
                <div class="import-stat import-stat--error">

                    <div class="import-stat__icon">

                        <i class="fa-light fa-user-xmark"></i>

                    </div>


                    <div class="import-stat__content">

                        <span>
                            Không tìm thấy
                        </span>

                        <strong>
                            {{notFoundCount}}
                        </strong>

                    </div>

                </div>

            </div>


            <!-- FOOTER -->
            <div class="import-result__footer">

                <span>

                    <i class="fa-light fa-circle-info"></i>

                    Dữ liệu sinh viên đã có trong lớp học phần
                    được tự động bỏ qua. Các sinh viên mới
                    được thêm vào lớp học phần.

                </span>


                <button type="button" class="import-result__reset">

                    <i class="fa-light fa-plus"></i>

                    Nhập file khác

                </button>

            </div>

        </div>

        {{/if}}

    </div>

</div>